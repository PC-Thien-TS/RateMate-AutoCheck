
# Example environment variables for RateMate-AutoCheck
# Copy this file to .env and fill in your secrets for local development

# API keys
API_KEY=dev-key
ADMIN_TOKEN=

# Database
PGHOST=localhost
PGPORT=5432
PGUSER=taas
PGPASSWORD=taas
PGDATABASE=taas

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=taas-artifacts
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# E2E test credentials
E2E_EMAIL=
E2E_PASSWORD=
FULL_NAME=QA Auto

# Site selection
SITE=ratemate

# Other options
TAAS_UPLOAD_MAX_MB=200
TAAS_UPLOAD_ALLOWED_EXTS=apk,ipa,aab,zip
E2E_ALLOW_WRITE=0
