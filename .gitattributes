# Set default behavior to automatically handle line endings.
# Git will normalize all text files to LF in the repository and convert them
# to the native line ending (CRLF on Windows, LF on Linux/macOS) on checkout.
* text=auto

# Explicitly declare text files for normalization.
# This ensures consistent handling even if a user has a strange local git config.
*.py text
*.js text
*.ts text
*.json text
*.md text
*.yml text
*.yaml text
*.html text
*.css text
*.ps1 text
*.sh text
*.txt text
*.example text

# These files should always have LF line endings, regardless of the OS.
.gitattributes text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf

# Mark binary files to prevent Git from trying to normalize them.
*.png binary
*.jpg binary
*.zip binary
*.apk binary
*.ipa binary
*.aab binary
*.xlsx binary