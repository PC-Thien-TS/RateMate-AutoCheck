{
  "name": "ratemate-taas",
  "displayName": "RateMate TaaS Assistant",
  "description": "VS Code extension that connects to the RateMate TaaS orchestrator for planning, generating, and running tests.",
  "version": "0.0.1",
  "publisher": "ratemate",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:taas.generateTests"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taas.generateTests",
        "title": "TaaS: Generate Tests",
        "category": "RateMate TaaS"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -w"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}